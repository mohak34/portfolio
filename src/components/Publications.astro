---
const publications = [
  {
    title: "A Multi-Task Deep Learning Framework for Diabetic Retinopathy Analysis",
    authors: "Subramanya Murthy, M., Agrawal, A., Lakshmi, D.",
    venue: "Applied Intelligence (Springer)",
    year: "2026",
    status: "Submitted"
  },
  {
    title: "Rethinking Temporal Graph Networks: A Comparative Study for Social Network Analysis",
    authors: "Subramanya Murthy, M., Shetty, D.P.",
    venue: "IEEE PUNECON",
    year: "2025",
    status: "Published",
    link: "https://ieeexplore.ieee.org/document/11378463"
  }
];
---

<section class="section publications">
  <div class="container">
    <h2 class="section-title">Publications</h2>
    <div class="publications-list" data-animate>
      {publications.map((pub) => (
        <div class="publication-item">
          <div class="ribbon">
            <span class="ribbon-text">{pub.year}</span>
          </div>
          <div class="publication-content">
            <h3 class="publication-title">
              {pub.link ? (
                <a href={pub.link} target="_blank" rel="noopener noreferrer">{pub.title}</a>
              ) : (
                pub.title
              )}
              {pub.link && (
                <a href={pub.link} target="_blank" rel="noopener noreferrer" class="icon-option" aria-label="View publication">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/><polyline points="16 3 21 3 21 8"/><line x1="11" y1="13" x2="21" y2="3"/></svg>
                </a>
              )}
            </h3>
            <p class="publication-meta"><span class="authors">{pub.authors}</span><span class="separator">•</span><span class="venue">{pub.venue}</span></p>
            <span class="publication-status">{pub.status}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .publications {
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .publications-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .publication-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    background: linear-gradient(135deg, var(--accent) 0%, rgba(121, 184, 255, 0.7) 100%);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  .ribbon::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .publication-item:hover .ribbon::before {
    left: 100%;
  }

  .ribbon-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bg-primary);
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    letter-spacing: 0.5px;
  }

  .publication-content {
    flex: 1;
    min-width: 0;
  }

  .publication-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
    line-height: 1.4;
    display: flex;
    align-items: center;
  }

  .publication-title a:first-child {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    flex: 1;
  }

  .publication-title a:first-child:hover {
    color: var(--accent);
  }

  .icon-option {
    flex-shrink: 0;
    margin-left: 0.75rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .publication-title:hover .icon-option,
  .publication-title a:first-child:hover + .icon-option {
    color: var(--accent);
  }

  .publication-title:has(.icon-option:hover) a:first-child {
    color: var(--accent);
  }

  .publication-meta {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .separator {
    color: var(--border);
  }

  .publication-status {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    color: var(--accent);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 3px;
  }

  @media (max-width: 480px) {
    .publication-item {
      gap: 1rem;
    }
  }
</style>
