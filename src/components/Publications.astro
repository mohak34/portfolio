<section class="section publications">
  <div class="container">
    <h2 class="section-title">Publications</h2>
    <div class="publication">
      <h3 class="publication-title">
        Rethinking Temporal Graph Networks: A Comparative Study for Social Network Analysis
      </h3>
      <p class="publication-meta">
        <span class="authors">Subramanya Murthy, M., Shetty, D.P.</span>
        <span class="separator">•</span>
        <span class="venue">IEEE PUNECON 2025</span>
      </p>
      <p class="publication-status">Accepted</p>
    </div>
  </div>
</section>

<style>
  .publications {
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .publication {
    padding: 1.5rem 0;
  }

  .publication-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .publication-meta {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .separator {
    color: var(--border);
  }

  .publication-status {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
</style>
