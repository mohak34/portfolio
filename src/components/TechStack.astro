---
const techStack = {
  "Languages": ["Python", "TypeScript", "JavaScript", "Go", "Java", "Lua", "Bash"],
  "ML/AI": ["PyTorch", "TensorFlow", "JAX", "Scikit-learn", "NumPy", "Pandas", "OpenCV", "MLflow"],
  "Frontend": ["React", "React Native", "Next.js", "Astro", "Tauri", "TanStack", "Tailwind CSS", "Vite"],
  "Backend": ["FastAPI", "Flask", "Node.js", "PostgreSQL", "MongoDB"],
  "Tools": ["Git", "Docker", "AWS"]
};
---

<section class="section techstack">
  <div class="container">
    <h2 class="section-title">Tech Stack</h2>
    <div class="stack-grid" data-animate-stagger>
      {Object.entries(techStack).map(([category, items]) => (
        <div class="stack-category">
          <h3 class="category-title">{category}</h3>
          <p class="category-items">
            {items.join(" • ")}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .techstack {
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .stack-category {
    padding: 0;
  }

  .category-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .category-items {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
