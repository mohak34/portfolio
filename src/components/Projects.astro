---
const projects = [
  {
    title: "Temporal Graph Networks",
    description: "TGN with fixed and adaptive decay mechanisms for community detection and link prediction, achieving improved silhouette scores and MRR.",
    tech: ["Graph Neural Networks", "PyTorch", "Social Network Analysis"],
    link: "https://github.com/mohak34/CommDec-DBTA"
  },
  {
    title: "Plastic Debris Detection",
    description: "Geospatial ML pipeline using Attention U-Net for semantic segmentation of plastic debris in Sentinel-2 satellite imagery.",
    tech: ["Satellite Imagery", "Semantic Segmentation", "U-Net", "Geospatial ML"],
    link: "https://github.com/OmdenaAI/TriesteItalyChapter_PlasticDebrisDetection"
  },
  {
    title: "Diabetic Retinopathy Analysis",
    description: "Multi-task pipeline for DR severity classification and lesion segmentation using EfficientNetV2-S with 85.5% accuracy.",
    tech: ["Medical Imaging", "Multi-task Learning", "EfficientNet", "PyTorch"],
    link: "https://github.com/mohak34/Diabetic-Retinopathy"
  },
  {
    title: "Indian Sign Language Recognition",
    description: "Real-time translation of Indian Sign Language to text and speech using deep learning and MediaPipe.",
    tech: ["Computer Vision", "Real-time Inference", "MediaPipe", "TensorFlow"],
    link: "https://github.com/mohak34/IndianSignLanguage"
  }
];
---

<section class="section projects">
  <div class="container">
    <h2 class="section-title">Projects</h2>
    <div class="projects-list">
      {projects.map((project) => (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-item">
          <div class="project-main">
            <span class="terminal-prompt">&gt;</span>
            <div class="project-content">
              <div class="project-header">
                <h3 class="project-title">{project.title}</h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </div>
              <p class="project-description">{project.description}</p>
              <div class="project-tech">
                {project.tech.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project-item {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    transition: background-color 0.2s ease;
  }

  .project-item:last-child {
    border-bottom: none;
  }

  .project-item:hover {
    background-color: var(--bg-secondary);
    margin: 0 -1rem;
    padding: 1.25rem 1rem;
  }

  .project-main {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .terminal-prompt {
    color: var(--accent);
    font-weight: 600;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 1rem;
    line-height: 1.5;
    flex-shrink: 0;
  }

  .project-content {
    flex: 1;
    min-width: 0;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .project-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .external-icon {
    color: var(--text-secondary);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .project-item:hover .external-icon {
    opacity: 1;
    color: var(--accent);
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.625rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tech-tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.4rem;
    background-color: transparent;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: rgba(88, 166, 255, 0.75);
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  }

  @media (max-width: 480px) {
    .project-main {
      gap: 0.75rem;
    }

    .project-item:hover {
      margin: 0 -0.5rem;
      padding: 1.25rem 0.5rem;
    }
  }
</style>
