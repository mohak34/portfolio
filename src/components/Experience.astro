---
const experiences = [
  {
    title: "Research Intern",
    company: "NITK Surathkal",
    period: "May 2025 - June 2025",
    description: "Developed Temporal Graph Networks with fixed and adaptive decay mechanisms for community detection and link prediction on Reddit dataset with 850K+ interactions."
  },
  {
    title: "Junior ML Engineer",
    company: "Omdena AI",
    period: "March 2025 - June 2025",
    description: "Built end-to-end geospatial ML pipeline for detecting plastic debris across Italian and Mediterranean Seas using satellite imagery and Attention U-Net."
  }
];
---

<section class="section experience">
  <div class="container">
    <h2 class="section-title">Experience</h2>
    <div class="experience-list">
      {experiences.map((exp, index) => (
        <div class="experience-item">
          <div class="accent-bar"></div>
          <div class="experience-content">
            <div class="experience-meta">
              <span class="experience-company">{exp.company}</span>
              <span class="experience-period">{exp.period}</span>
            </div>
            <h3 class="experience-title">{exp.title}</h3>
            <p class="experience-description">{exp.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .experience-item:hover {
    border-color: var(--accent);
    background-color: var(--bg-secondary);
  }

  .accent-bar {
    width: 3px;
    flex-shrink: 0;
    background: linear-gradient(180deg, var(--accent) 0%, rgba(88, 166, 255, 0.2) 100%);
    border-radius: 2px;
  }

  .experience-content {
    flex: 1;
    min-width: 0;
  }

  .experience-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .experience-company {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .experience-period {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
  }

  .experience-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .experience-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .experience-item {
      gap: 1rem;
      padding: 1rem;
    }

    .experience-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
